# Public site URL (used for canonicals, sitemap, schema)
SITE_URL=https://www.thebrandmediamarketing.com

# Lead delivery — server-side only. Never expose these to the browser.
# Generic CRM webhook (HubSpot / Zoho / LeadSquared / Make / Zapier / n8n). Receives scored lead JSON.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Email/WhatsApp follow-up automation webhook (receives lead + nurture track).
FOLLOWUP_WEBHOOK_URL=
# Optional: Cloudflare Turnstile spam protection
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Local fallback storage for leads when no CRM is configured (JSONL). Leave empty to disable.
LEAD_STORE_PATH=./data/leads/leads.jsonl
