---
/**
 * Case study: strategy pillars feeding one outcome.
 * Cards in a row, joined by a connector line to an outcome bar underneath.
 */
import Icon from '../infographics/Icon.astro';
interface Pillar { title: string; body: string; icon: string }
interface Props { pillars: Pillar[]; outcome: string; outcomeBody?: string }
const { pillars, outcome, outcomeBody } = Astro.props;
---
<figure class="pf" aria-label={`${pillars.map((p) => p.title).join(', ')} combine into ${outcome}`}>
  <ol class="pf-grid" role="list">
    {pillars.map((p, i) => (
      <li class="pf-card" style={`--i:${i}`}>
        <span class="pf-num">{String(i + 1).padStart(2, '0')}</span>
        <span class="pf-ico"><Icon name={p.icon} size={26} /></span>
        <h3 class="pf-title">{p.title}</h3>
        <p class="pf-body">{p.body}</p>
        <span class="pf-stem" aria-hidden="true"></span>
      </li>
    ))}
  </ol>
  <div class="pf-rail" aria-hidden="true"></div>
  <div class="pf-outcome">
    <p class="pf-outcome-title">{outcome}</p>
    {outcomeBody && <p class="pf-outcome-body">{outcomeBody}</p>}
  </div>
</figure>
<style>
  .pf { display: grid; gap: 0; }
  .pf-grid { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); }
  .pf-card { position: relative; display: flex; flex-direction: column; gap: 0.55rem; padding: 1.35rem 1.2rem 1.6rem; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease); }
  .pf-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--royal-500); }
  .pf-num { position: absolute; top: 1rem; right: 1.1rem; font-family: var(--font-serif); font-size: 1.6rem; color: var(--royal-100); font-weight: 600; }
  .pf-ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 12px; background: var(--royal-50); color: var(--royal-600); }
  .pf-title { font-size: 1.05rem; font-family: var(--font-sans); color: var(--navy-900); }
  .pf-body { font-size: 0.88rem; color: var(--ink-2); line-height: 1.5; }
  .pf-stem { position: absolute; left: 50%; bottom: -1.05rem; width: 2px; height: 1.05rem; background: linear-gradient(var(--royal-500), var(--royal-600)); }
  .pf-rail { height: 2px; margin: 1rem 8% 0; background: linear-gradient(90deg, transparent, var(--royal-600) 10%, var(--royal-600) 90%, transparent); }
  .pf-outcome { position: relative; margin: 0 auto; margin-top: 1.1rem; text-align: center; padding: 1.1rem 1.75rem; border-radius: 999px; background: linear-gradient(135deg, var(--navy-900), var(--royal-700)); color: #fff; max-width: 640px; box-shadow: 0 18px 40px -18px rgb(31 79 216 / 0.6); }
  .pf-outcome::before { content: ''; position: absolute; left: 50%; top: -1.1rem; width: 2px; height: 1.1rem; background: var(--royal-600); }
  .pf-outcome-title { font-family: var(--font-serif); font-size: var(--step-2); line-height: 1.2; }
  .pf-outcome-body { font-size: 0.88rem; color: #c4cde6; margin-top: 0.25rem; }
  @media (max-width: 760px) { .pf-stem, .pf-rail, .pf-outcome::before { display: none; } .pf-outcome { margin-top: 1rem; border-radius: var(--radius); } }
  @media (prefers-reduced-motion: no-preference) {
    .pf-card { animation: pfin 0.6s var(--ease) both; animation-delay: calc(var(--i) * 0.08s); }
    @keyframes pfin { from { opacity: 0; transform: translateY(10px); } }
  }
</style>
