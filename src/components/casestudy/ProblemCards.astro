---
/** Case study: challenge as cards. Problem, why it was happening, and what it cost the business. */
import Icon from '../infographics/Icon.astro';
interface Problem { problem: string; why: string; cost: string; icon: string }
interface Props { items: Problem[] }
const { items } = Astro.props;
---
<ul class="pc" role="list">
  {items.map((p, i) => (
    <li class="pc-card" style={`--i:${i}`}>
      <div class="pc-head"><span class="pc-ico"><Icon name={p.icon} size={22} /></span><h3>{p.problem}</h3></div>
      <p class="pc-why"><span>Why</span>{p.why}</p>
      <p class="pc-cost"><span>Cost to the business</span>{p.cost}</p>
    </li>
  ))}
</ul>
<style>
  .pc { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .pc-card { display: flex; flex-direction: column; gap: 0.8rem; padding: 1.25rem; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--series-2); }
  .pc-head { display: flex; gap: 0.75rem; align-items: center; }
  .pc-ico { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: #fdeee7; color: #c4501f; }
  .pc-head h3 { font-size: 1.02rem; font-family: var(--font-sans); color: var(--navy-900); line-height: 1.3; }
  .pc-why, .pc-cost { font-size: 0.88rem; color: var(--ink-2); line-height: 1.5; }
  .pc-why span, .pc-cost span { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.15rem; }
  .pc-cost { padding-top: 0.7rem; border-top: 1px dashed var(--line-2); }
  .pc-cost span { color: #c4501f; }
</style>
