---
/**
 * Case study: the acquisition loop as a ring diagram (SVG, zero JS).
 * Three or four stages around a circle, joined by arrowed arcs, with a centre label.
 * The stage details are listed beside the ring so they stay readable on small screens.
 */
interface Stage { name: string; channels: string; body: string }
interface Props { stages: Stage[]; centre: string; centreSub?: string }
const { stages, centre, centreSub } = Astro.props;
const S = 340, C = S / 2, R = 124, nodeR = 40;
const n = stages.length;
const ang = (i: number) => (-90 + (360 / n) * i) * (Math.PI / 180);
const pt = (a: number, r = R) => [C + r * Math.cos(a), C + r * Math.sin(a)];
// arc from node i to node i+1, trimmed so it starts/ends outside the node circles
const gap = (nodeR + 10) / R;
const arcs = stages.map((_, i) => {
  const a1 = ang(i) + gap, a2 = ang(i + 1) - gap;
  const [x1, y1] = pt(a1), [x2, y2] = pt(a2);
  return `M${x1.toFixed(1)},${y1.toFixed(1)} A${R},${R} 0 0 1 ${x2.toFixed(1)},${y2.toFixed(1)}`;
});
const tones = ['#1f4fd8', '#7a5af0', '#0f7b4a', '#eb6834'];
---
<div class="al">
  <svg class="al-ring" viewBox={`0 0 ${S} ${S}`} role="img" aria-label={`${centre}: ${stages.map((s) => s.name).join(', then ')}, then back to ${stages[0]?.name}`}>
    <defs>
      <marker id="al-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1 1 9 5 1 9z" fill="#8fa3cf" />
      </marker>
      <radialGradient id="al-core" cx="50%" cy="40%" r="60%"><stop offset="0" stop-color="#1f4fd8" /><stop offset="1" stop-color="#0a1a3f" /></radialGradient>
    </defs>
    <circle cx={C} cy={C} r={R} fill="none" stroke="#e8ecf5" stroke-width="16" />
    {arcs.map((d) => <path d={d} fill="none" stroke="#8fa3cf" stroke-width="2.5" stroke-dasharray="1 7" stroke-linecap="round" marker-end="url(#al-arrow)" />)}
    <circle cx={C} cy={C} r={70} fill="url(#al-core)" />
    <text x={C} y={centreSub ? C - 4 : C + 5} text-anchor="middle" class="al-c">{centre}</text>
    {centreSub && <text x={C} y={C + 16} text-anchor="middle" class="al-cs">{centreSub}</text>}
    {stages.map((s, i) => {
      const [x, y] = pt(ang(i));
      return (
        <g>
          <circle cx={x} cy={y} r={nodeR} fill="#fff" stroke={tones[i % tones.length]} stroke-width="3" />
          <text x={x} y={y - 3} text-anchor="middle" class="al-n" fill={tones[i % tones.length]}>{String(i + 1).padStart(2, '0')}</text>
          <text x={x} y={y + 14} text-anchor="middle" class="al-nn">{s.name}</text>
        </g>
      );
    })}
  </svg>
  <ol class="al-list" role="list">
    {stages.map((s, i) => (
      <li style={`--c:${tones[i % tones.length]}`}>
        <span class="al-dot">{String(i + 1).padStart(2, '0')}</span>
        <div><h3>{s.name} <small>{s.channels}</small></h3><p>{s.body}</p></div>
      </li>
    ))}
  </ol>
</div>
<style>
  .al { display: grid; gap: clamp(1.5rem, 4vw, 3rem); grid-template-columns: minmax(0, 360px) minmax(0, 1fr); align-items: center; }
  .al-ring { width: 100%; max-width: 360px; margin-inline: auto; }
  .al-c { font-family: var(--font-sans); font-size: 13px; font-weight: 700; fill: #fff; }
  .al-cs { font-size: 10.5px; fill: #a9bbe6; }
  .al-n { font-size: 15px; font-weight: 800; }
  .al-nn { font-size: 11px; font-weight: 700; fill: #0a1a3f; }
  .al-list { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .al-list li { display: grid; grid-template-columns: 44px 1fr; gap: 0.9rem; align-items: start; padding: 1rem 1.1rem; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--c); }
  .al-dot { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--c); color: var(--c); font-weight: 800; font-size: 0.9rem; }
  .al-list h3 { font-size: 1.05rem; font-family: var(--font-sans); color: var(--navy-900); }
  .al-list small { display: block; font-size: 0.78rem; font-weight: 600; color: var(--ink-3); margin-top: 0.1rem; }
  .al-list p { font-size: 0.88rem; color: var(--ink-2); margin-top: 0.35rem; line-height: 1.5; }
  @media (max-width: 820px) { .al { grid-template-columns: 1fr; } }
</style>
