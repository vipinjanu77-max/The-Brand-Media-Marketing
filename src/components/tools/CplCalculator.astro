---
import NumField from './NumField.astro';
---
<div class="tool" data-tool="cpl">
  <form class="inputs" onsubmit="return false" aria-label="CPL calculator inputs">
    <div class="two">
      <NumField k="spend" label="Ad spend" prefix="₹" value={100000} step={1000} />
      <NumField k="leads" label="Leads" value={200} />
      <NumField k="qualifiedPct" label="Leads that are qualified" suffix="%" value={40} max={100} />
      <NumField k="closeRatePct" label="Qualified leads that buy" suffix="%" value={15} max={100} step={0.5} />
      <NumField k="dealValue" label="Average deal value" prefix="₹" value={100000} step={1000} />
      <NumField k="grossMarginPct" label="Gross margin" suffix="%" value={30} max={100} />
    </div>
  </form>
  <section class="results" aria-live="polite">
    <h2>Your cost per lead</h2>
    <div class="out-grid">
      <div class="out"><span class="out-label">CPL</span><span class="out-value" data-out="cpl">-</span></div>
      <div class="out"><span class="out-label">Cost per qualified lead</span><span class="out-value" data-out="cpql">-</span></div>
      <div class="out"><span class="out-label">Customers</span><span class="out-value" data-out="cust">-</span></div>
      <div class="out"><span class="out-label">Cost per customer</span><span class="out-value" data-out="cpc">-</span></div>
      <div class="out out--wide"><span class="out-label">Break-even CPL (max you can pay)</span><span class="out-value" data-out="max">-</span></div>
    </div>
    <p class="verdict" data-out="verdict"></p>
    <p class="disclaimer">Estimates, not guarantees. Break-even CPL covers first-sale gross profit only; it excludes sales team and overhead costs.</p>
  </section>
</div>
<script>
  import { bindCalc } from '../../lib/toolkit';
  import { cpl, inr, num } from '../../lib/calculators';
  document.querySelectorAll<HTMLElement>('[data-tool="cpl"]').forEach((root) =>
    bindCalc(root, 'cpl', (i) => {
      const r = cpl(i as any);
      const ok = r.cpl !== null && r.cpl < r.maxBreakEvenCpl;
      return {
        cpl: inr(r.cpl), cpql: inr(r.costPerQualifiedLead), cust: num(r.customers, 1), cpc: inr(r.costPerCustomer), max: inr(r.maxBreakEvenCpl),
        verdict: r.cpl === null ? '' : ok ? `Your CPL is ${num((r.cpl / r.maxBreakEvenCpl) * 100)}% of break-even: leads are paying for themselves on first sale.` : 'Your CPL is above break-even. Improve qualification, close rate or deal value (or lower CPL) before scaling.',
      };
    }),
  );
</script>
