---
interface Props { sources: { title: string; publisher: string; year: string; url: string }[]; accessed?: Date }
const { sources, accessed } = Astro.props;
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-h">
    <h2 id="sources-h">Sources</h2>
    <ol>
      {sources.map((s) => (
        <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a> — {s.publisher}, {s.year}.</li>
      ))}
    </ol>
    {accessed && <p class="small muted">Sources accessed or re-checked on {accessed.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}. We paraphrase and cite; we do not reproduce copyrighted material.</p>}
  </section>
)}
<style>
  .sources { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .sources h2 { font-size: var(--step-2); margin-bottom: 1rem; }
  ol { padding-left: 1.3rem; display: grid; gap: 0.5rem; font-size: 0.92rem; color: var(--ink-2); }
</style>
