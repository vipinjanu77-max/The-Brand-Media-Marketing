---
import Breadcrumbs from './Breadcrumbs.astro';
import Artwork from '../art/Artwork.astro';
import type { Crumb } from '../../layouts/Base.astro';
interface Props {
  crumbs?: Crumb[];
  eyebrow?: string;
  title: string;
  lede?: string;
  wide?: boolean;
  art?: { seed: string; motif?: string; variant?: 'deep' | 'royal' | 'light'; label?: string };
}
const { crumbs, eyebrow, title, lede, wide, art } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero--art': art }]}>
  <div class="container">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <div class="ph-grid">
      <div class="ph-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 style={wide ? 'max-width:28ch' : undefined}>{title}</h1>
        {lede && <p class="lede">{lede}</p>}
        {Astro.slots.has('default') && <div class="btn-row"><slot /></div>}
        <slot name="after" />
      </div>
      {art && (
        <div class="ph-art">
          <Artwork seed={art.seed} motif={art.motif} variant={art.variant ?? 'deep'} ratio="4/3" label={art.label} />
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .ph-grid { display: grid; gap: 2rem; align-items: center; }
  .page-hero .breadcrumbs + .ph-grid { margin-top: 1.5rem; }
  .ph-copy h1 { margin-top: 1rem; }
  .ph-art { border-radius: 22px; overflow: hidden; box-shadow: 0 30px 60px -30px rgb(10 26 63 / 0.55); transform: perspective(1200px) rotateY(-4deg); }
  @media (min-width: 960px) {
    .page-hero--art .ph-grid { grid-template-columns: 1.25fr 1fr; gap: 4rem; }
  }
  @media (max-width: 959px) { .ph-art { transform: none; max-width: 560px; } }
  @media (prefers-reduced-motion: no-preference) {
    .ph-art { animation: rise 0.9s var(--ease) both; }
    @keyframes rise { from { opacity: 0; transform: perspective(1200px) rotateY(-4deg) translateY(16px); } }
  }
</style>
