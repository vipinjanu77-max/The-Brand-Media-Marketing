---
/**
 * Consent-aware analytics.
 * - Google Consent Mode v2 defaults to denied; nothing loads until the visitor opts in.
 * - IDs come from the CMS settings file (public IDs only, never secrets).
 * - window.tbmTrack(event, params) pushes to dataLayer (GTM/GA4) and, where relevant, Meta Pixel.
 * - Any element with data-track="event_name" (plus data-* params) is tracked on click.
 */
import { site } from '../../lib/site';
const { gtmId, ga4Id, metaPixelId, googleAdsId } = site.analytics;
---
<script is:inline define:vars={{ gtmId, ga4Id, metaPixelId, googleAdsId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });

  var loaded = {};
  function load(src, id) { if (loaded[id]) return; loaded[id] = 1; var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); }

  window.tbmApplyConsent = function (c) {
    gtag('consent', 'update', {
      analytics_storage: c.analytics ? 'granted' : 'denied',
      ad_storage: c.marketing ? 'granted' : 'denied',
      ad_user_data: c.marketing ? 'granted' : 'denied',
      ad_personalization: c.marketing ? 'granted' : 'denied',
    });
    if (!c.analytics && !c.marketing) return;
    if (gtmId) {
      dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      load('https://www.googletagmanager.com/gtm.js?id=' + gtmId, 'gtm');
    } else if (ga4Id || googleAdsId) {
      load('https://www.googletagmanager.com/gtag/js?id=' + (ga4Id || googleAdsId), 'gtag');
      gtag('js', new Date());
      if (ga4Id) gtag('config', ga4Id, { anonymize_ip: true });
      if (googleAdsId && c.marketing) gtag('config', googleAdsId);
    }
    if (metaPixelId && c.marketing && !window.fbq) {
      var n = (window.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); });
      n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
      load('https://connect.facebook.net/en_US/fbevents.js', 'fbq');
      window.fbq('init', metaPixelId);
      window.fbq('track', 'PageView');
    }
  };

  var META_EVENTS = { lead_submitted: 'Lead', resource_download: 'Lead', booking_click: 'Schedule' };
  window.tbmTrack = function (event, params) {
    params = params || {};
    dataLayer.push(Object.assign({ event: event }, params));
    if (window.fbq && META_EVENTS[event]) window.fbq('track', META_EVENTS[event], params);
  };

  try {
    var saved = JSON.parse(localStorage.getItem('tbm-consent') || 'null');
    if (saved) window.tbmApplyConsent(saved);
  } catch (e) {}

  document.addEventListener('click', function (e) {
    var el = e.target instanceof Element ? e.target.closest('[data-track]') : null;
    if (!el) return;
    var p = { page_path: location.pathname };
    for (var k in el.dataset) if (k !== 'track') p[k] = el.dataset[k];
    if (el.textContent) p.label = el.textContent.trim().slice(0, 80);
    window.tbmTrack(el.dataset.track, p);
  });
</script>
