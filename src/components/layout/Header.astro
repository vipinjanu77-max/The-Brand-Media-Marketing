---
import Logo from './Logo.astro';
import { nav } from '../../lib/nav';
import { auditHref, bookingHref } from '../../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href) && href !== '/';
---
<header class="site-header" data-header>
  <div class="container bar">
    <Logo />
    <nav class="primary" aria-label="Primary">
      <ul class="menu" role="list">
        {nav.map((item, i) => (
          <li class="menu-item" data-menu-item>
            <button
              class:list={['menu-trigger', { active: isActive(item.href) }]}
              aria-expanded="false"
              aria-controls={`mega-${i}`}
              data-menu-trigger
            >
              {item.label}
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </button>
            <div class="mega" id={`mega-${i}`} data-mega hidden>
              <div class="container mega-inner">
                <div class="mega-groups" style={`--cols:${Math.min(item.groups.length, 4)}`}>
                  {item.groups.map((g) => (
                    <div class="mega-group">
                      <p class="mega-heading">{g.heading}</p>
                      <ul role="list">
                        {g.links.map((l) => (
                          <li>
                            <a href={l.href} class="mega-link">
                              <span class="mega-label">{l.label}</span>
                              {l.desc && <span class="mega-desc">{l.desc}</span>}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                {item.feature ? (
                  <a class="mega-feature" href={item.feature.href}>
                    <span class="eyebrow">{item.feature.eyebrow}</span>
                    <strong>{item.feature.title}</strong>
                    <span>{item.feature.body}</span>
                    <span class="text-link">{item.feature.cta}</span>
                  </a>
                ) : (
                  <a class="mega-feature" href={item.href}>
                    <span class="eyebrow">Overview</span>
                    <strong>All {item.label.toLowerCase()}</strong>
                    <span>Browse everything in {item.label}.</span>
                    <span class="text-link">Explore</span>
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <a href="/search/" class="icon-btn" aria-label="Search the site">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" /><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </a>
      <a href={bookingHref()} class="btn btn--ghost btn--sm hide-mobile" data-track="cta_click" data-cta="request_callback_header">Request a Call Back</a>
      <a href={auditHref} class="btn btn--sm" data-track="cta_click" data-cta="growth_audit_header">Get Growth Audit</a>
      <button class="icon-btn burger hide-desktop" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="sr-only">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <nav aria-label="Mobile">
      {nav.map((item) => (
        <details>
          <summary>{item.label}</summary>
          <a href={item.href} class="mobile-overview">{item.label} overview</a>
          {item.groups.map((g) => (
            <div class="mobile-group">
              <p class="mega-heading">{g.heading}</p>
              <ul role="list">{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </div>
          ))}
        </details>
      ))}
      <div class="btn-row mobile-ctas">
        <a href={auditHref} class="btn">Get Growth Audit</a>
        <a href={bookingHref()} class="btn btn--ghost">Request a Call Back</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-menu-item]')];
  let closeTimer: number | undefined;

  const close = (except?: HTMLElement) =>
    items.forEach((li) => {
      if (li === except) return;
      li.querySelector('[data-menu-trigger]')!.setAttribute('aria-expanded', 'false');
      (li.querySelector('[data-mega]') as HTMLElement).hidden = true;
    });
  const open = (li: HTMLElement) => {
    close(li);
    li.querySelector('[data-menu-trigger]')!.setAttribute('aria-expanded', 'true');
    (li.querySelector('[data-mega]') as HTMLElement).hidden = false;
  };

  const canHover = matchMedia('(hover: hover) and (min-width: 1100px)').matches;
  items.forEach((li) => {
    const trigger = li.querySelector<HTMLButtonElement>('[data-menu-trigger]')!;
    trigger.addEventListener('click', () => {
      trigger.getAttribute('aria-expanded') === 'true' ? close() : open(li);
    });
    if (canHover) {
      li.addEventListener('mouseenter', () => { clearTimeout(closeTimer); open(li); });
      li.addEventListener('mouseleave', () => { closeTimer = window.setTimeout(() => close(), 140); });
    }
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node)) close();
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openLi = items.find((li) => li.querySelector('[aria-expanded="true"]'));
    close();
    openLi?.querySelector<HTMLButtonElement>('[data-menu-trigger]')?.focus();
  });
  document.addEventListener('click', (e) => { if (!header.contains(e.target as Node)) close(); });

  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mobile = document.querySelector<HTMLElement>('[data-mobile-nav]')!;
  burger.addEventListener('click', () => {
    const expanded = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!expanded));
    mobile.hidden = expanded;
    document.documentElement.classList.toggle('nav-open', !expanded);
  });

  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / 0.92); backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid transparent; transition: border-color 0.2s, box-shadow 0.2s; }
  .site-header.scrolled { border-bottom-color: var(--line); box-shadow: 0 1px 0 rgb(10 26 63 / 0.02); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 72px; }
  .primary { display: none; }
  .menu { display: flex; list-style: none; padding: 0; gap: 0.1rem; }
  .menu-trigger {
    display: inline-flex; align-items: center; gap: 0.35rem; background: none; border: 0; padding: 0.6rem 0.8rem;
    font-weight: 560; font-size: 0.95rem; color: var(--ink); border-radius: 999px;
  }
  .menu-trigger:hover, .menu-trigger[aria-expanded='true'] { background: var(--paper-2); color: var(--navy-900); }
  .menu-trigger.active { color: var(--royal-600); }
  .menu-trigger svg { transition: transform 0.2s var(--ease); }
  .menu-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); box-shadow: 0 24px 48px -24px rgb(10 26 63 / 0.25); }
  @media (prefers-reduced-motion: no-preference) {
    .mega:not([hidden]) { animation: drop 0.22s var(--ease); }
    @keyframes drop { from { opacity: 0; transform: translateY(-6px); } }
  }
  .mega-inner { display: grid; grid-template-columns: 1fr 280px; gap: 2.5rem; padding-block: 2rem 2.25rem; }
  .mega-groups { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 1.5rem 2rem; }
  .mega-heading { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.6rem; }
  .mega-group ul { list-style: none; padding: 0; display: grid; gap: 0.1rem; }
  .mega-link { display: grid; padding: 0.45rem 0.6rem; margin-inline: -0.6rem; border-radius: var(--radius-sm); text-decoration: none; color: var(--ink); }
  .mega-link:hover { background: var(--royal-50); }
  .mega-label { font-weight: 580; font-size: 0.95rem; }
  .mega-link:hover .mega-label { color: var(--royal-700); }
  .mega-desc { font-size: 0.82rem; color: var(--ink-3); }
  .mega-feature { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.5rem; border-radius: var(--radius); background: var(--navy-900); color: #c4cde6; text-decoration: none; }
  .mega-feature strong { font-family: var(--font-serif); font-size: 1.35rem; color: #fff; font-weight: 560; line-height: 1.2; }
  .mega-feature .eyebrow { color: #8fb0ff; }
  .mega-feature .text-link { color: #fff; margin-top: auto; }
  .mega-feature:hover { background: var(--navy-800); }
  .actions { display: flex; align-items: center; gap: 0.5rem; }
  .icon-btn { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; background: none; border: 0; color: var(--navy-900); }
  .icon-btn:hover { background: var(--paper-2); }
  .mobile-nav { border-top: 1px solid var(--line); max-height: calc(100dvh - 72px); overflow-y: auto; background: #fff; padding: 0.5rem var(--gutter) 2rem; }
  .mobile-nav details { border-bottom: 1px solid var(--line); }
  .mobile-nav summary { padding: 1rem 0; font-weight: 620; font-size: 1.1rem; cursor: pointer; color: var(--navy-900); list-style: none; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary::after { content: '+'; float: right; color: var(--royal-600); }
  .mobile-nav details[open] summary::after { content: '-'; }
  .mobile-overview { display: block; margin-bottom: 0.75rem; font-weight: 600; }
  .mobile-group { margin-bottom: 1rem; }
  .mobile-group ul { list-style: none; padding: 0; display: grid; gap: 0.1rem; }
  .mobile-group a { display: block; padding: 0.45rem 0; color: var(--ink); text-decoration: none; }
  .mobile-ctas { margin-top: 1.5rem; }
  .mobile-ctas .btn { flex: 1 1 100%; }
  .actions .btn { white-space: nowrap; }
  @media (min-width: 1100px) and (max-width: 1279px) { .actions .btn--ghost { display: none; } }
  @media (min-width: 1100px) {
    .primary { display: block; }
    .burger { display: none !important; }
  }
  @media (max-width: 1099px) {
    .actions .btn:not(.hide-mobile) { display: none; }
    .burger { display: inline-grid !important; }
  }
  :global(html.nav-open) { overflow: hidden; }
</style>
