---
/** Decorative-but-honest animated funnel: stages only, no invented numbers. */
const stages = ['Traffic', 'Leads', 'Qualified leads', 'Customers', 'Revenue'];
---
<div class="funnel" aria-label="Growth funnel: Traffic, Leads, Qualified leads, Customers, Revenue" role="img">
  {stages.map((s, i) => (
    <div class="stage" style={`--i:${i};--w:${100 - i * 15}%`}>
      <span class="bar-f"><span class="flow" /></span>
      <span class="name">{s}</span>
    </div>
  ))}
  <p class="note">Every stage measured. Every stage optimised.</p>
</div>
<style>
  .funnel { display: grid; gap: 0.55rem; padding: 1.75rem; border-radius: 20px; background: linear-gradient(160deg, var(--navy-900), var(--navy-800)); box-shadow: 0 30px 60px -30px rgb(10 26 63 / 0.6); color: #fff; }
  .stage { position: relative; display: grid; justify-items: center; }
  .bar-f { position: relative; display: block; width: var(--w); height: 46px; border-radius: 10px; background: linear-gradient(90deg, rgb(53 102 232 / 0.9), rgb(111 149 245 / 0.9)); overflow: hidden; }
  .stage:nth-child(4) .bar-f, .stage:nth-child(5) .bar-f { background: linear-gradient(90deg, #fff, #dfe8ff); }
  .name { position: absolute; top: 12px; font-weight: 620; font-size: 0.95rem; letter-spacing: 0.01em; }
  .stage:nth-child(4) .name, .stage:nth-child(5) .name { color: var(--navy-900); }
  .flow { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.35), transparent); transform: translateX(-100%); }
  .note { margin-top: 0.6rem; text-align: center; font-size: 0.85rem; color: #aab5d3; }
  @media (prefers-reduced-motion: no-preference) {
    .flow { animation: sweep 3.6s var(--ease) infinite; animation-delay: calc(var(--i) * 0.35s); }
    .bar-f { animation: grow 0.9s var(--ease) both; animation-delay: calc(var(--i) * 0.12s); }
    @keyframes sweep { 0% { transform: translateX(-100%); } 60%, 100% { transform: translateX(100%); } }
    @keyframes grow { from { transform: scaleX(0.6); opacity: 0; } }
  }
</style>
