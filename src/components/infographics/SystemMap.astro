---
/** Infographic: how TBM connects the growth system, with a feedback loop. */
import Icon from './Icon.astro';
const nodes = [
  { t: 'Strategy', d: 'Economics, audience, positioning', i: 'compass' },
  { t: 'Acquisition', d: 'Google, Meta, SEO, AEO, content', i: 'target' },
  { t: 'Conversion', d: 'Pages, WhatsApp, qualification', i: 'layout' },
  { t: 'Retention', d: 'CRM, nurture, repeat', i: 'flow' },
  { t: 'Measurement', d: 'CPL, CAC, ROAS, revenue', i: 'chart' },
  { t: 'Optimization', d: 'Test, learn, scale', i: 'sparkle' },
];
---
<figure class="sm" aria-label="TBM connects strategy, acquisition, conversion, retention, measurement and optimization in a continuous loop">
  <ol class="sm-row" role="list">
    {nodes.map((n, i) => (
      <li class="sm-node reveal" style={`--i:${i};transition-delay:${i * 70}ms`}>
        <span class="sm-ico"><Icon name={n.i} /></span>
        <span class="sm-n">{String(i + 1).padStart(2, '0')}</span>
        <strong>{n.t}</strong>
        <span class="sm-d">{n.d}</span>
      </li>
    ))}
  </ol>
  <div class="sm-loop" aria-hidden="true">
    <svg viewBox="0 0 1000 60" preserveAspectRatio="none"><path d="M960 6 V30 Q960 50 940 50 H60 Q40 50 40 30 V6" fill="none" stroke="#6f95f5" stroke-width="2" stroke-dasharray="6 6" vector-effect="non-scaling-stroke" /><path d="M32 16 40 4 48 16" fill="none" stroke="#6f95f5" stroke-width="2" vector-effect="non-scaling-stroke" /></svg>
    <span>Every result feeds the next cycle</span>
  </div>
  <figcaption class="sr-only">A six-stage loop: Strategy, Acquisition, Conversion, Retention, Measurement, Optimization, then back to Strategy.</figcaption>
</figure>
<style>
  .sm { margin-top: 1.5rem; }
  .sm-row { list-style: none; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); }
  .sm-node { position: relative; display: grid; gap: 0.3rem; align-content: start; padding: 1.1rem; border-radius: 16px; background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.14); color: #c4cde6; }
  .sm-node strong { color: #fff; font-size: 1.02rem; }
  .sm-d { font-size: 0.84rem; line-height: 1.4; }
  .sm-ico { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #1f4fd8, #6f95f5); color: #fff; margin-bottom: 0.4rem; box-shadow: 0 10px 24px -10px rgb(53 102 232 / 0.8); }
  .sm-n { position: absolute; top: 1rem; right: 1rem; font-family: var(--font-serif); color: #6f95f5; font-size: 0.9rem; }
  @media (min-width: 1000px) {
    .sm-node:not(:last-child)::after { content: ''; position: absolute; right: -0.62rem; top: 2.1rem; width: 0.5rem; height: 0.5rem; border-top: 2px solid #6f95f5; border-right: 2px solid #6f95f5; transform: rotate(45deg); }
  }
  .sm-loop { position: relative; margin-top: 0.25rem; height: 60px; display: none; }
  @media (min-width: 1000px) { .sm-loop { display: block; } }
  .sm-loop svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sm-loop span { position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); padding: 0.15rem 0.8rem; background: var(--navy-900); color: #9fb8ff; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; white-space: nowrap; }
</style>
