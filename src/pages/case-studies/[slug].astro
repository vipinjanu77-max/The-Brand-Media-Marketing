---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CTABand from '../../components/ui/CTABand.astro';
import RelatedContent from '../../components/ui/RelatedContent.astro';
export async function getStaticPaths() {
  // Only verified, client-approved, non-draft case studies generate pages in production.
  // In `npm run dev` only, drafts also render (with a DRAFT banner) so they can be reviewed locally.
  // Production builds and staging previews never include them.
  const published = (c: CollectionEntry<'caseStudies'>) => c.data.verified && c.data.clientApprovalOnFile && !c.data.draft;
  return (await getCollection('caseStudies', (c) => published(c) || (import.meta.env.DEV && c.id !== 'example-template'))).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'caseStudies'> };
const d = entry.data;
const isDraftPreview = !(d.verified && d.clientApprovalOnFile && !d.draft);
const isStory = d.template === 'story';
const { Content } = await render(entry);
const crumbs = [{ name: 'Case studies', href: '/case-studies/' }, { name: d.clientNamePublic ? d.client : d.industry, href: `/case-studies/${entry.id}/` }];
// Show service names instead of slugs, linked to their pages.
const serviceEntries = await getCollection('services');
const services = d.services.map((s) => {
  const e = serviceEntries.find((x) => x.id === s);
  return { slug: s, name: e ? e.data.navLabel : s, href: e ? `/services/${s}/` : undefined };
});
const verifyNote = isDraftPreview
  ? 'Unverified draft figures. Not for publication.'
  : 'Verified against platform/CRM data with client approval. Results are specific to this client, market and period.';
---
<Base title={d.title} description={d.challenge} seo={isDraftPreview ? { ...d.seo, noindex: true } : d.seo} crumbs={crumbs} ogType="article" updated={d.date}>
  {isDraftPreview && <div class="container mt-2"><p class="notice notice--demo" role="status"><strong>DRAFT PREVIEW (local only).</strong> Not verified or client-approved. This page is never built for production.</p></div>}
  <PageHero crumbs={crumbs} eyebrow={`Case study | ${d.industry} | ${d.location}`} title={d.title} lede={d.businessImpact} art={isStory ? { seed: entry.id, motif: d.heroMotif ?? 'chart', variant: 'deep' } : undefined} />

  {isStory ? (
    <>
      <section class="cs-facts-wrap">
        <div class="container">
          <dl class="facts facts--story">
            <div><dt>Client</dt><dd>{d.clientNamePublic ? d.client : `${d.industry} business (name withheld at client's request)`}</dd></div>
            <div><dt>Location</dt><dd>{d.location}, {d.country}</dd></div>
            <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>
            <div><dt>Budget range</dt><dd>{d.budgetRange}</dd></div>
            <div class="facts-wide"><dt>Services</dt><dd class="tags">{services.map((s) => s.href ? <a class="tag" href={s.href}>{s.name}</a> : <span class="tag">{s.name}</span>)}</dd></div>
            <div class="facts-wide"><dt>Platforms</dt><dd class="tags">{d.platforms.map((p) => <span class="tag tag--neutral">{p}</span>)}</dd></div>
          </dl>
        </div>
      </section>
      <div class="cs-story"><Content /></div>
      <section class="section section--alt">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Full results</p>
            <h2>Every number, before and after</h2>
            <p class="lede">"Before" is the three-month average before work started; "after" is the average of months 4 to 6.</p>
          </div>
          <div class="table-wrap"><table class="data-table">
            <thead><tr><th scope="col">Metric</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Change</th></tr></thead>
            <tbody>{d.metrics.map((m) => <tr><th scope="row">{m.label}</th><td class="num">{m.before}</td><td class="num">{m.after}</td><td class="num">{m.change ?? '-'}</td></tr>)}</tbody>
          </table></div>
          <p class="small muted mt-1"><strong>{verifyNote}</strong> See our <a href="/legal/marketing-results-disclaimer/">results disclaimer</a>.</p>
          {d.learnings.length > 0 && (
            <div class="mt-3">
              <h3 class="h">What we learned</h3>
              <ol class="learn mt-1" role="list">{d.learnings.map((l, i) => <li><span class="learn-n">{String(i + 1).padStart(2, '0')}</span><p>{l}</p></li>)}</ol>
            </div>
          )}
          {d.testimonial && <figure class="quote mt-3"><blockquote>"{d.testimonial.quote}"</blockquote><figcaption>{d.testimonial.person}, {d.testimonial.role}</figcaption></figure>}
          {d.evidence.length > 0 && <div class="gallery mt-3">{d.evidence.map((e) => <figure><img src={e.image} alt={e.alt} loading="lazy" decoding="async" /><figcaption class="small muted">{e.caption}</figcaption></figure>)}</div>}
        </div>
      </section>
    </>
  ) : (
    <section class="section">
      <div class="container">
        <dl class="facts">
          <div><dt>Client</dt><dd>{d.clientNamePublic ? d.client : `${d.industry} business (name withheld at client's request)`}</dd></div>
          <div><dt>Location</dt><dd>{d.location}, {d.country}</dd></div>
          <div><dt>Services</dt><dd>{services.map((s) => s.name).join(', ')}</dd></div>
          <div><dt>Platforms</dt><dd>{d.platforms.join(', ')}</dd></div>
          <div><dt>Budget range</dt><dd>{d.budgetRange}</dd></div>
          <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>
        </dl>
        <div class="grid grid-2 mt-3">
          <div class="card"><h2 class="h">Challenge</h2><p>{d.challenge}</p></div>
          <div class="card"><h2 class="h">Starting point</h2><p>{d.startingPoint}</p></div>
          <div class="card"><h2 class="h">Objective</h2><p>{d.objective}</p></div>
        </div>
        <h2 class="mt-3 h2">Results</h2>
        <div class="table-wrap mt-1"><table class="data-table">
          <thead><tr><th scope="col">Metric</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Change</th></tr></thead>
          <tbody>{d.metrics.map((m) => <tr><th scope="row">{m.label}</th><td class="num">{m.before}</td><td class="num">{m.after}</td><td class="num">{m.change ?? '-'}</td></tr>)}</tbody>
        </table></div>
        {isDraftPreview ? <p class="small muted mt-1"><strong>Unverified draft figures.</strong> Not for publication.</p> : <p class="small muted mt-1">Verified against platform/CRM data with client approval. Results are specific to this client, market and period: see our <a href="/legal/marketing-results-disclaimer/">results disclaimer</a>.</p>}
        <div class="prose mt-3"><Content /></div>
        {d.learnings.length > 0 && <><h2 class="mt-3 h2">Learnings</h2><ul class="check-list mt-1">{d.learnings.map((l) => <li>{l}</li>)}</ul></>}
        {d.testimonial && <figure class="quote mt-3"><blockquote>"{d.testimonial.quote}"</blockquote><figcaption>{d.testimonial.person}, {d.testimonial.role}</figcaption></figure>}
        {d.evidence.length > 0 && <div class="grid grid-2 mt-3">{d.evidence.map((e) => <figure><img src={e.image} alt={e.alt} loading="lazy" decoding="async" /><figcaption class="small muted">{e.caption}</figcaption></figure>)}</div>}
      </div>
    </section>
  )}
  <RelatedContent type="caseStudy" slug={entry.id} />
  <CTABand stage="high-intent" />
</Base>
<style>
  .facts { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); }
  dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  dd { font-weight: 600; color: var(--navy-900); }
  .h { font-size: var(--step-1); font-family: var(--font-sans); }
  .h2 { font-size: var(--step-3); }
  .quote blockquote { font-family: var(--font-serif); font-size: var(--step-2); color: var(--navy-900); }

  /* Story layout */
  .cs-facts-wrap { padding-block: 1.5rem 0; }
  .facts--story { background: #fff; box-shadow: var(--shadow); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .facts--story .facts-wide { grid-column: span 2; }
  .facts--story dd.tags { margin-top: 0.35rem; }
  .facts--story a.tag { text-decoration: none; }
  .facts--story a.tag:hover { background: var(--royal-100); }
  @media (max-width: 820px) { .facts--story { grid-template-columns: 1fr 1fr; } .facts--story .facts-wide { grid-column: 1 / -1; } }
  .learn { list-style: none; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .learn li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; padding: 1rem 1.1rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .learn-n { font-family: var(--font-serif); font-size: 1.5rem; color: var(--royal-600); line-height: 1.1; }
  .learn p { font-size: 0.92rem; color: var(--ink-2); line-height: 1.5; }
  .gallery { columns: 3 260px; column-gap: 1rem; }
  .gallery figure { break-inside: avoid; margin-bottom: 1rem; }
  .gallery img { border-radius: var(--radius); }
</style>
<style is:global>
  /* Story-layout helpers used inside case-study MDX bodies (scoped to .cs-story). */
  .cs-story .section-head h2 { font-size: var(--step-4); line-height: 1.08; }
  .cs-story .cs-copy > * + * { margin-top: 1rem; }
  .cs-story .cs-copy p:not(.lede) { color: var(--ink-2); }
  .cs-brandline { margin-top: 1.75rem !important; padding: 1.5rem 1.75rem; border-radius: var(--radius); background: linear-gradient(135deg, var(--royal-50), #fff); border: 1px solid var(--royal-100); }
  .cs-brandline blockquote { font-family: var(--font-serif); font-size: var(--step-2); color: var(--navy-900); line-height: 1.25; }
  .cs-brandline figcaption { margin-top: 0.4rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--royal-600); }
  .cs-chips { list-style: none; padding: 0; display: grid; gap: 0.5rem; margin-top: 1.5rem !important; }
  .cs-chips li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0.9rem; border-radius: var(--radius-sm); background: #fff; border: 1px solid var(--line); font-weight: 650; color: var(--navy-900); font-size: 0.92rem; }
  .cs-chips li span { font-weight: 500; color: var(--ink-3); font-size: 0.84rem; text-align: right; }
  .cs-perf { display: grid; gap: 1rem; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: stretch; }
  @media (max-width: 820px) { .cs-perf { grid-template-columns: 1fr; } }
  .cs-stats { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .cs-stats li { display: flex; flex-direction: column; justify-content: center; gap: 0.2rem; padding: 1.1rem 1.25rem; border-radius: var(--radius); background: linear-gradient(135deg, var(--navy-900), var(--royal-700)); color: #c4cde6; }
  .cs-stats strong { font-family: var(--font-serif); font-size: var(--step-2); color: #fff; line-height: 1.1; }
  .cs-stats span { font-size: 0.85rem; }
  .cs-insights { list-style: none; padding: 0; margin-top: 1.5rem; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); counter-reset: ins; }
  .cs-insights li { counter-increment: ins; position: relative; padding: 1.1rem 1.1rem 1.1rem 3.2rem; border-radius: var(--radius); background: var(--paper-2); font-size: 0.9rem; color: var(--ink-2); line-height: 1.5; }
  .cs-insights li::before { content: counter(ins, decimal-leading-zero); position: absolute; left: 1rem; top: 1rem; font-family: var(--font-serif); font-size: 1.15rem; color: var(--royal-600); }
  .cs-insights strong { display: block; color: var(--navy-900); margin-bottom: 0.2rem; }
  .cs-econ { margin: 2rem auto 0; max-width: 720px; text-align: center; font-size: 0.86rem; color: #a9b6d6; }
  .cs-final { padding-block: clamp(3.5rem, 7vw, 6rem); background: radial-gradient(100% 120% at 10% 0%, #1f4fd8 0%, var(--navy-900) 50%, var(--navy-950) 100%); color: #d7def0; }
  .cs-final-line { font-family: var(--font-serif); font-size: var(--step-4); line-height: 1.12; color: #fff; max-width: 22ch; }
  .cs-quote { margin-top: 2.5rem; max-width: 760px; padding-left: 1.5rem; border-left: 3px solid #8fb0ff; }
  .cs-quote blockquote { font-family: var(--font-serif); font-size: var(--step-1); font-style: italic; color: #e6ebf7; line-height: 1.5; }
  .cs-quote figcaption { margin-top: 0.8rem; display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; font-size: 0.88rem; color: #a9b6d6; }
</style>
