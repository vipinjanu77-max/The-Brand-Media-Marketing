---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CTABand from '../../components/ui/CTABand.astro';
import RelatedContent from '../../components/ui/RelatedContent.astro';
export async function getStaticPaths() {
  // Only verified, client-approved, non-draft case studies generate pages.
  return (await getCollection('caseStudies', (c) => c.data.verified && c.data.clientApprovalOnFile && !c.data.draft)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'caseStudies'> };
const d = entry.data;
const { Content } = await render(entry);
const crumbs = [{ name: 'Case studies', href: '/case-studies/' }, { name: d.clientNamePublic ? d.client : d.industry, href: `/case-studies/${entry.id}/` }];
---
<Base title={d.title} description={d.challenge} seo={d.seo} crumbs={crumbs} ogType="article" updated={d.date}>
  <PageHero crumbs={crumbs} eyebrow={`${d.industry} | ${d.location}`} title={d.title} lede={d.businessImpact} />
  <section class="section">
    <div class="container">
      <dl class="facts">
        <div><dt>Client</dt><dd>{d.clientNamePublic ? d.client : `${d.industry} business (name withheld at client's request)`}</dd></div>
        <div><dt>Location</dt><dd>{d.location}, {d.country}</dd></div>
        <div><dt>Services</dt><dd>{d.services.join(', ')}</dd></div>
        <div><dt>Platforms</dt><dd>{d.platforms.join(', ')}</dd></div>
        <div><dt>Budget range</dt><dd>{d.budgetRange}</dd></div>
        <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>
      </dl>
      <div class="grid grid-2 mt-3">
        <div class="card"><h2 class="h">Challenge</h2><p>{d.challenge}</p></div>
        <div class="card"><h2 class="h">Starting point</h2><p>{d.startingPoint}</p></div>
        <div class="card"><h2 class="h">Objective</h2><p>{d.objective}</p></div>
      </div>
      <h2 class="mt-3 h2">Results</h2>
      <div class="table-wrap mt-1"><table class="data-table">
        <thead><tr><th scope="col">Metric</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Change</th></tr></thead>
        <tbody>{d.metrics.map((m) => <tr><th scope="row">{m.label}</th><td class="num">{m.before}</td><td class="num">{m.after}</td><td class="num">{m.change ?? '-'}</td></tr>)}</tbody>
      </table></div>
      <p class="small muted mt-1">Verified against platform/CRM data with client approval. Results are specific to this client, market and period: see our <a href="/legal/marketing-results-disclaimer/">results disclaimer</a>.</p>
      <div class="prose mt-3"><Content /></div>
      {d.learnings.length > 0 && <><h2 class="mt-3 h2">Learnings</h2><ul class="check-list mt-1">{d.learnings.map((l) => <li>{l}</li>)}</ul></>}
      {d.testimonial && <figure class="quote mt-3"><blockquote>"{d.testimonial.quote}"</blockquote><figcaption>{d.testimonial.person}, {d.testimonial.role}</figcaption></figure>}
      {d.evidence.length > 0 && <div class="grid grid-2 mt-3">{d.evidence.map((e) => <figure><img src={e.image} alt={e.alt} loading="lazy" decoding="async" /><figcaption class="small muted">{e.caption}</figcaption></figure>)}</div>}
    </div>
  </section>
  <RelatedContent type="caseStudy" slug={entry.id} />
  <CTABand stage="high-intent" />
</Base>
<style>
  .facts { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); }
  dt { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  dd { font-weight: 600; color: var(--navy-900); }
  .h { font-size: var(--step-1); font-family: var(--font-sans); }
  .h2 { font-size: var(--step-3); }
  .quote blockquote { font-family: var(--font-serif); font-size: var(--step-2); color: var(--navy-900); }
</style>
