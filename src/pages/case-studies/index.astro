---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import { isPublishedCaseStudy as isPublished } from '../../lib/caseStudies';
// In `npm run dev` only, drafts are listed too (tagged) so they can be reviewed locally. Production lists published entries only.
const cases = (await getCollection('caseStudies', (c) => isPublished(c) || (import.meta.env.DEV && c.id !== 'example-template'))).sort((a, b) => +b.data.date - +a.data.date);
const industries = [...new Set(cases.map((c) => c.data.industry))];
const crumbs = [{ name: 'Case studies', href: '/case-studies/' }];
const fields = ['Client', 'Industry', 'Location', 'Business challenge', 'Starting point', 'Objective', 'Strategy', 'Execution', 'Campaign structure', 'Budget range', 'Timeline', 'Before', 'After', 'Results', 'Business impact', 'Learnings', 'Client testimonial', 'Visual evidence'];
---
<Base title="Case Studies" description="TBM case studies: challenge, strategy, execution, budget range, timeline and before-and-after results." crumbs={crumbs} pageType="CollectionPage">
  <PageHero crumbs={crumbs} art={{ seed: 'case-studies', motif: 'frame', variant: 'deep' }} eyebrow="Work" title="Case studies with the working shown." lede="Every case study states the starting point, the strategy, the campaign structure, budget range, timeline and before-and-after numbers." />
  <section class="section">
    <div class="container">
      {cases.length > 0 ? (
        <>
          <div class="filters" role="group" aria-label="Filter by industry" data-cs-filter>
            <button class="chip" aria-pressed="true" data-v="">All</button>
            {industries.map((i) => <button class="chip" aria-pressed="false" data-v={i}>{i}</button>)}
          </div>
          <div class="grid grid-3 mt-2">
            {cases.map((c) => (
              <article class="card" data-industry={c.data.industry}>
                <div class="tags">{!isPublished(c) && <span class="tag" style="background:#fff6e5;color:#6d4b00">Draft (local only)</span>}<span class="tag">{c.data.industry}</span><span class="tag tag--neutral">{c.data.location}</span></div>
                <h2 class="h"><a class="card-link" href={`/case-studies/${c.id}/`}>{c.data.title}</a></h2>
                <p>{c.data.challenge}</p>
                {c.data.metrics[0] && <p class="meta"><strong>{c.data.metrics[0].label}:</strong> {c.data.metrics[0].before} to {c.data.metrics[0].after}</p>}
              </article>
            ))}
          </div>
        </>
      ) : (
        <div class="empty">
          <Placeholder label="NO CASE STUDIES PUBLISHED: add one in the CMS (Case Studies collection) and turn off Draft" />
          <h2 class="h">What every TBM case study will include</h2>
          <ul class="tags" role="list">{fields.map((f) => <li class="tag tag--neutral">{f}</li>)}</ul>
          <p class="muted">While case studies are being added, you can see <a href="/reporting-demo/">how we report</a> and <a href="/process/">how we work</a>, or ask for anonymised examples during a <a href="/contact/?intent=strategy-call">strategy call</a>.</p>
        </div>
      )}
    </div>
  </section>
  <CTABand stage="bofu" />
</Base>
<script>
  const root = document.querySelector('[data-cs-filter]');
  root?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-industry]').forEach((c) => (c.hidden = !!b.dataset.v && c.dataset.industry !== b.dataset.v));
  }));
</script>
<style>
  .h { font-size: var(--step-1); font-family: var(--font-sans); font-weight: 650; }
  .empty { display: grid; gap: 1.25rem; max-width: 860px; }
  ul.tags { list-style: none; padding: 0; }
</style>
