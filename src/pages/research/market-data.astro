---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import DataConfidence from '../../components/ui/DataConfidence.astro';
import KindBadge from '../../components/ui/KindBadge.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import { dataset as datasetSchema } from '../../lib/schema';
const datasets = await getCollection('datasets');
const origin = Astro.site?.origin ?? Astro.url.origin;
const crumbs = [{ name: 'Research', href: '/research/' }, { name: 'TBM Market Data', href: '/research/market-data/' }];
const metrics = ['Average CPL', 'CPC', 'CTR', 'Conversion rate', 'CAC', 'ROAS', 'CPM', 'Lead quality', 'Search demand', 'Organic traffic growth', 'Paid traffic performance'];
---
<Base title="TBM Market Data — Original Benchmarks" description="TBM's original, anonymised marketing benchmark programme for India — methodology, sample size, date range, limitations and data confidence published up front." crumbs={crumbs}
  schema={datasets.filter((d) => d.data.status === 'published').map((d) => datasetSchema({ name: d.data.title, description: d.data.description, url: new URL('/research/market-data/', origin).href, origin, temporal: d.data.dateRange, spatial: 'India' }))}>
  <PageHero crumbs={crumbs} eyebrow="Original research" title="TBM Market Data" lede="Proprietary benchmarks built from campaigns we manage — published with the sample, method and limitations visible, and never passed off as a market average." />
  <section class="section">
    <div class="container">
      <div class="compare-labels">
        <div class="card"><KindBadge kind="TBM Original Dataset" /><h2 class="h">TBM Dataset</h2><p>Data TBM collected itself from managed accounts, with client permission, anonymised and aggregated. Representative of TBM’s client mix — not the whole market.</p></div>
        <div class="card"><span class="tag tag--neutral">Third-Party Market Data</span><h2 class="h">Industry research</h2><p>Figures from regulators, platforms, research firms and industry bodies — cited with source, year, geography and method in our <a href="/statistics/">statistics database</a>.</p></div>
      </div>
      {datasets.map((d) => (
        <article class="ds">
          <div class="ds-head">
            <div class="tags"><KindBadge kind={d.data.label} /><span class:list={['tag', d.data.status === 'collecting' ? 'tag--warn' : 'tag--good']}>{d.data.status === 'collecting' ? 'Data collection in progress' : 'Published'}</span></div>
            <h2>{d.data.title}</h2>
            <p class="lede">{d.data.description}</p>
            <DataConfidence level={d.data.confidence} reason={d.data.status === 'collecting' ? 'sample still being collected; no figures published yet' : undefined} />
          </div>
          <dl class="ds-meta">
            <div><dt>Sample size</dt><dd>{d.data.sampleSize}</dd></div>
            <div><dt>Date range</dt><dd>{d.data.dateRange}</dd></div>
            <div><dt>Breakdowns</dt><dd>{d.data.breakdowns.join(' · ')}</dd></div>
            <div><dt>Methodology</dt><dd>{d.data.methodology}</dd></div>
          </dl>
          <h3>Metrics we will report</h3>
          <ul class="tags mt-1">{metrics.map((m) => <li class="tag tag--neutral">{m}</li>)}</ul>
          <h3 class="mt-2">Limitations</h3>
          <ul class="lim">{d.data.limitations.map((l) => <li>{l}</li>)}</ul>
          <h3 class="mt-2">Results</h3>
          {d.data.metrics.length > 0 ? (
            <div class="table-wrap mt-1"><table class="data-table">
              <thead><tr><th scope="col">Metric</th><th scope="col">Segment</th><th scope="col">Value</th><th scope="col">n</th></tr></thead>
              <tbody>{d.data.metrics.map((m) => <tr><th scope="row">{m.metric}</th><td>{m.segment}</td><td class="num">{m.value}</td><td class="num">{m.n}</td></tr>)}</tbody>
            </table></div>
          ) : <Placeholder label="TBM DATASET RESULTS — to be published once minimum sample thresholds are met" />}
        </article>
      ))}
    </div>
  </section>
  <CTABand stage="tofu" title="Want to contribute anonymised data?" body="Clients can opt in to the benchmark programme and receive a private comparison report against anonymised peers. Ask your TBM strategist." />
</Base>
<style>
  .compare-labels { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); margin-bottom: 3rem; }
  .h { font-size: var(--step-2); }
  .ds { padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--line); border-radius: 20px; }
  .ds-head { display: grid; gap: 1rem; }
  .ds-head h2 { font-size: var(--step-3); }
  .ds-meta { display: grid; gap: 1rem; margin-block: 2rem; padding: 1.25rem; background: var(--paper-2); border-radius: var(--radius); }
  .ds-meta div { display: grid; gap: 0.25rem; }
  @media (min-width: 700px) { .ds-meta div { grid-template-columns: 160px 1fr; } }
  dt { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .ds h3 { font-size: var(--step-1); }
  .ds ul.tags { list-style: none; padding: 0; }
  .lim { padding-left: 1.2rem; color: var(--ink-2); display: grid; gap: 0.35rem; margin-top: 0.75rem; }
</style>
