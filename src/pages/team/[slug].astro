---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CTABand from '../../components/ui/CTABand.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import { person } from '../../lib/schema';
import { articleHref } from '../../lib/graph';
import { preview } from '../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('team', (t) => preview || !t.data.placeholder)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'team'> };
const d = entry.data;
const origin = Astro.site?.origin ?? Astro.url.origin;
const url = new URL(`/team/${entry.id}/`, origin).href;
const articles = await getCollection('blog', (b) => !b.data.draft && (b.data.author === entry.id || b.data.reviewer === entry.id));
const research = await getCollection('research', (r) => !r.data.draft && (r.data.author === entry.id || r.data.reviewer === entry.id));
const crumbs = [{ name: 'Team', href: '/team/' }, { name: d.placeholder ? 'Profile' : d.name, href: `/team/${entry.id}/` }];
const schema = d.placeholder ? null : d.type === 'organization' ? null : person({ name: d.name, role: d.role, url, origin, image: d.photo, sameAs: d.linkedin ? [d.linkedin] : undefined, knowsAbout: d.expertise });
---
<Base title={d.placeholder ? 'Team profile' : `${d.name} — ${d.role}`} description={d.bio.slice(0, 155)} seo={{ ...d.seo, noindex: d.placeholder || d.seo.noindex }} crumbs={crumbs} pageType="ProfilePage" schema={[schema]}>
  <PageHero crumbs={crumbs} eyebrow={d.role} title={d.name} />
  <section class="section">
    <div class="container--narrow stack" style="--stack:1.5rem">
      {d.placeholder && <Placeholder label="PLACEHOLDER PROFILE — not indexed. Admin to add verified details." />}
      <p class="lede">{d.bio}</p>
      {d.experience && <p><strong>Experience:</strong> {d.experience}</p>}
      {d.expertise.length > 0 && <div class="tags">{d.expertise.map((e) => <span class="tag tag--neutral">{e}</span>)}</div>}
      {d.linkedin && <p><a href={d.linkedin} rel="me noopener" target="_blank">LinkedIn profile</a></p>}
      {d.projects.length > 0 && <><h2 class="h">Projects</h2><ul>{d.projects.map((p) => <li>{p}</li>)}</ul></>}
      {(articles.length > 0 || research.length > 0) && (
        <>
          <h2 class="h">Articles & research</h2>
          <ul>
            {articles.map((a) => <li><a href={articleHref(a)}>{a.data.title}</a> <span class="muted small">({a.data.author === entry.id ? 'author' : 'reviewer'})</span></li>)}
            {research.map((r) => <li><a href={`/research/${r.id}/`}>{r.data.title}</a></li>)}
          </ul>
        </>
      )}
    </div>
  </section>
  <CTABand stage="bofu" />
</Base>
<style>.h { font-size: var(--step-2); }</style>
