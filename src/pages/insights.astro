---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CTABand from '../components/ui/CTABand.astro';
import { articleHref } from '../lib/graph';
const blog = (await getCollection('blog', (e) => !e.data.draft)).sort((a, b) => +b.data.updated - +a.data.updated);
const research = (await getCollection('research', (e) => !e.data.draft)).sort((a, b) => +b.data.updated - +a.data.updated);
const glossaryCount = (await getCollection('glossary')).length;
const compareCount = (await getCollection('compare')).length;
const statCount = (await getCollection('statistics')).length;
const hubs = [
  ['Marketing Research', '/research/', `${research.length} research pages`],
  ['Statistics Database', '/statistics/', `${statCount} sourced statistics`],
  ['TBM Market Data', '/research/market-data/', 'Original benchmark programme'],
  ['Guides', '/guides/', `${blog.filter((b) => b.data.pillar).length} pillar guides`],
  ['Blog', '/blog/', `${blog.filter((b) => !b.data.pillar).length} articles`],
  ['Comparisons', '/compare/', `${compareCount} comparisons`],
  ['Glossary', '/glossary/', `${glossaryCount} terms`],
  ['FAQs', '/faqs/', 'Common questions'],
];
const clusters = [
  { t: 'Digital Marketing in India', d: 'The pillar: what digital marketing is, how it works and what it costs.', links: [['What is digital marketing?', '/guides/what-is-digital-marketing/'], ['Digital marketing cost in India', '/guides/digital-marketing-cost-india/'], ['India statistics', '/research/digital-marketing-statistics-india/']] },
  { t: 'SEO & AI search', d: 'Organic visibility in results and in answers.', links: [['How long does SEO take?', '/blog/how-long-does-seo-take/'], ['What is AEO?', '/blog/what-is-aeo/'], ['SEO vs AEO', '/compare/seo-vs-aeo/']] },
  { t: 'Paid advertising', d: 'Google, Meta and LinkedIn — budgets and targets.', links: [['Google Ads budget', '/blog/how-much-should-you-spend-on-google-ads/'], ['What is a good CPL?', '/blog/what-is-a-good-cpl/'], ['Google Ads vs Meta Ads', '/compare/google-ads-vs-meta-ads/']] },
  { t: 'Agency selection', d: 'Choosing and working with a partner.', links: [['How to choose an agency', '/guides/how-to-choose-a-digital-marketing-agency/'], ['Agency vs freelancer', '/compare/agency-vs-freelancer/'], ['Agency evaluation tool', '/tools/agency-evaluation-checklist/']] },
];
const crumbs = [{ name: 'Insights', href: '/insights/' }];
---
<Base title="Insights — Research, Guides & Marketing Knowledge" description="TBM's marketing knowledge platform: research, statistics, pillar guides, articles, comparisons, glossary and FAQs, organised into topic clusters." crumbs={crumbs} pageType="CollectionPage">
  <PageHero crumbs={crumbs} eyebrow="Insights" title="A marketing knowledge platform, not a content calendar." lede="Research → analysis → original insight → practical recommendation. Organised into topic clusters so you can go from question to decision." />
  <section class="section"><div class="container grid grid-4">
    {hubs.map(([t, h, m]) => <a class="card" href={h}><h2 class="h">{t}</h2><p class="meta">{m}</p></a>)}
  </div></section>
  <section class="section section--alt"><div class="container">
    <SectionHead eyebrow="Topic clusters" title="Start with a question." />
    <div class="grid grid-2">
      {clusters.map((c) => <div class="card"><h3>{c.t}</h3><p>{c.d}</p><ul>{c.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul></div>)}
    </div>
  </div></section>
  <section class="section"><div class="container">
    <SectionHead title="Latest" />
    <div class="grid grid-3">
      {[...blog.map((b) => ({ t: b.data.title, h: articleHref(b), d: b.data.description, u: b.data.updated, k: b.data.pillar ? 'Guide' : 'Article' })), ...research.map((r) => ({ t: r.data.title, h: `/research/${r.id}/`, d: r.data.description, u: r.data.updated, k: 'Research' }))].sort((a, b) => +b.u - +a.u).slice(0, 9).map((x) => (
        <article class="card"><span class="tag tag--neutral">{x.k}</span><h3><a class="card-link" href={x.h}>{x.t}</a></h3><p>{x.d}</p></article>
      ))}
    </div>
  </div></section>
  <CTABand stage="tofu" />
</Base>
<style>.h { font-size: var(--step-1); font-family: var(--font-sans); font-weight: 650; }</style>
