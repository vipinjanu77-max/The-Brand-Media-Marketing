---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/home/HeroVisual.astro';
import SystemMap from '../components/infographics/SystemMap.astro';
import Artwork from '../components/art/Artwork.astro';
import BarChart from '../components/charts/BarChart.astro';
import { clusterMotif, toolMotif } from '../lib/motifs';
import GrowthSystem from '../components/home/GrowthSystem.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import FAQ from '../components/ui/FAQ.astro';
import CTABand from '../components/ui/CTABand.astro';
import StatCard from '../components/ui/StatCard.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import { problems, onboarding } from '../lib/growth';
import { tools } from '../lib/tools';
import { site, auditHref, preview } from '../lib/site';
import { faqPage } from '../lib/schema';
import { articleHref } from '../lib/graph';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const cases = (await getCollection('caseStudies', (e) => e.data.verified && !e.data.draft)).slice(0, 3);
const testimonials = await getCollection('testimonials', (e) => e.data.verified && e.data.consentOnFile);
const team = (await getCollection('team', (e) => e.data.type === 'person' && (preview || !e.data.placeholder))).sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection('research', (e) => !e.data.draft)).sort((a, b) => +b.data.updated - +a.data.updated);
const stats = (await getCollection('statistics')).filter((s) => ['india-digital-share-2025', 'india-internet-users-2025', 'global-ai-overviews-users-2025'].includes(s.id));
const articles = (await getCollection('blog', (e) => !e.data.draft)).sort((a, b) => +b.data.updated - +a.data.updated).slice(0, 3);
const datasets = await getCollection('datasets');
const marketChart = research.find((r) => r.id === 'india-digital-advertising-2025')?.data.charts[0];
const generalFaqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order).flatMap((f) => f.data.items).slice(0, 7);

const groups: Record<string, string> = { performance: 'Acquisition', search: 'Search & AI', social: 'Social & Reputation', creative: 'Brand & Creative', web: 'Conversion', crm: 'CRM & Messaging', analytics: 'Measurement' };
const pillars = ['Strategy', 'Performance', 'SEO', 'Creative', 'Technology', 'Analytics'];
const why = [
  { t: 'We start from your economics', d: 'Targets come from your margins, close rates and payback tolerance, not platform averages.' },
  { t: 'One system, not a menu', d: 'Strategy, acquisition, conversion and measurement planned together, with one owner.' },
  { t: 'Evidence over adjectives', d: 'We publish our methods, label our data and only show verified results.' },
  { t: 'You own everything', d: 'Ad accounts, data, creative and dashboards stay in your name.' },
  { t: 'Transparent pricing', d: 'Fees, media, production and technology shown separately on every proposal.' },
  { t: 'Built for AI-era search', d: 'SEO and AEO so your business is found and cited, in results and in answers.' },
];
---
<Base
  title="Growth & Digital Marketing Agency in India"
  description="TBM combines strategy, performance marketing, SEO, AEO, creative, technology and analytics to help businesses acquire customers, improve conversion and build sustainable growth."
  seo={{ title: 'The Brand Media Marketing (TBM): Growth & Digital Marketing Agency' }}
  schema={[faqPage(generalFaqs)]}
  exitIntent
>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Strategy. Acquisition. Conversion. Growth.</p>
        <h1>We Don't Just Run Campaigns.<br /><span>We Build Growth Systems.</span></h1>
        <p class="lede">TBM combines strategy, performance marketing, SEO, creative, technology and analytics to help businesses acquire customers, improve conversion and build sustainable growth.</p>
        <div class="btn-row">
          <a href={auditHref} class="btn" data-track="cta_click" data-cta="hero_growth_audit">Get Your Free Growth Audit <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <a href="/case-studies/" class="btn btn--ghost" data-track="cta_click" data-cta="hero_explore_work">Explore Our Work</a>
        </div>
        <p class="hero-note small muted">No lock-in pitch. A clear view of where your growth is leaking, and what to fix first.</p>
      </div>
      <div class="hero-visual"><HeroVisual /></div>
    </div>
  </section>

  <!-- 2. TRUST BAR -->
  <section class="trust" aria-label="What TBM brings together">
    <div class="container">
      <ul class="pillars" role="list">{pillars.map((p) => <li>{p}</li>)}</ul>
      <p class="trust-line">Built for measurable business outcomes.</p>
      {site.verifiedClientLogos.length === 0 && preview && (
        <p class="small muted center">Client logos appear here only when verified and approved. <span class="sr-only">No client logos shown.</span></p>
      )}
    </div>
  </section>

  <!-- 3. BUSINESS PROBLEM -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="The problem" title="Marketing shouldn't be a collection of disconnected activities." lede="Most businesses don't have a channel problem. They have a system problem: activities that each look busy but don't add up to growth." />
      <div class="grid grid-4 problems">
        {problems.map((p) => (
          <div class="problem reveal"><h3>{p.t}</h3><p>{p.d}</p></div>
        ))}
      </div>
      <div class="connect reveal">
        <p class="connect-title">TBM connects the entire system.</p>
        <SystemMap />
      </div>
    </div>
  </section>

  <!-- 4. GROWTH SYSTEM -->
  <section class="section section--navy" id="growth-system">
    <div class="container">
      <SectionHead eyebrow="Our Growth System" title="Seven stages. One accountable system." lede="Every engagement runs through the same operating model, so you always know what we are doing, why, and how it will be measured." />
      <GrowthSystem />
      <p class="mt-2"><a href="/process/" class="text-link">See how onboarding works week by week <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
    </div>
  </section>

  <!-- 5. SERVICES -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Services" title="Capabilities, connected." lede="Each service stands on its own. They work best as parts of one system with shared goals and shared data." />
      <div class="svc-groups">
        {Object.entries(groups).map(([g, label]) => {
          const list = services.filter((s) => s.data.group === g);
          return list.length > 0 && (
            <div class="svc-group reveal">
              <p class="svc-label">{label}</p>
              <ul role="list">{list.map((s) => <li><a href={`/services/${s.id}/`}><strong>{s.data.navLabel}</strong><span>{s.data.summary}</span></a></li>)}</ul>
            </div>
          );
        })}
      </div>
      <p class="mt-2"><a class="btn btn--ghost" href="/services/">All services</a></p>
    </div>
  </section>

  <!-- 6. INDUSTRY SOLUTIONS -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead eyebrow="Industries" title="These people understand my business." lede="Every industry has its own funnel, economics and rules. Our industry playbooks start there." />
      <div class="grid grid-3">
        {industries.filter((i) => i.data.featured).map((i) => (
          <article class="card reveal">
            <div class="card-media"><Artwork seed={i.id} variant="royal" /></div>
            <h3><a class="card-link" href={`/industries/${i.id}/`}>{i.data.title}</a></h3>
            <p>{i.data.summary}</p>
            <p class="meta">KPIs: {i.data.kpis.slice(0, 3).join(' | ')}</p>
          </article>
        ))}
      </div>
      <ul class="ind-more" role="list">
        {industries.filter((i) => !i.data.featured).map((i) => <li><a href={`/industries/${i.id}/`}>{i.data.title.replace(/ Marketing.*$/, '')}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- 7 & 8. RESULTS + CASE STUDIES -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Results & case studies" title="They have evidence." lede="We publish only results verified against platform or CRM data, with client approval. No rounded-up screenshots. No invented numbers." />
      {cases.length > 0 ? (
        <div class="grid grid-3">
          {cases.map((c) => (
            <article class="card">
              <span class="tag">{c.data.industry}</span>
              <h3><a class="card-link" href={`/case-studies/${c.id}/`}>{c.data.title}</a></h3>
              <p>{c.data.businessImpact}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty">
          <Placeholder label="VERIFIED CASE STUDY DATA REQUIRED: admin to publish verified case studies in the CMS" />
          <div class="empty-body">
            <p>Our case studies go live as clients approve publication. Each one will show the starting point, strategy, campaign structure, budget range, timeline, before-and-after metrics and what we learned.</p>
            <div class="btn-row">
              <a href="/results/" class="btn btn--ghost btn--sm">Results library</a>
              <a href="/reporting-demo/" class="btn btn--ghost btn--sm">See how we report</a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 9 & 10. MARKETING INTELLIGENCE + ORIGINAL RESEARCH -->
  <section class="section section--alt">
    <div class="container">
      <SectionHead eyebrow="TBM Marketing Intelligence" title="We teach the market before we sell to it." lede="A growing research platform with sourced, dated and clearly labelled data, so your decisions start from evidence." />
      <div class="intel-grid">
        {marketChart && <div class="intel-chart"><BarChart {...marketChart} id="home-market" /></div>}
        <div class="intel-stats">{stats.map((s) => <StatCard stat={s} compact />)}</div>
      </div>
      <div class="split split--even mt-3">
        <div>
          <p class="svc-label">Latest research</p>
          <ul class="list-links" role="list">
            {research.slice(0, 4).map((r) => <li><a href={`/research/${r.id}/`}><strong>{r.data.title}</strong><span>{r.data.label} | Updated {r.data.updated.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}</span></a></li>)}
          </ul>
          <a class="text-link mt-1" href="/research/">Explore Marketing Intelligence <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="card card--navy">
          <span class="eyebrow">Original research</span>
          <h3>{datasets[0]?.data.title ?? 'TBM Market Data'}</h3>
          <p>{datasets[0]?.data.description}</p>
          <p class="small">Status: <strong>{datasets[0]?.data.status === 'collecting' ? 'Data collection in progress: methodology published' : 'Published'}</strong>. We will never present TBM's own sample as an 'India market average'.</p>
          <a class="btn btn--light btn--sm" href="/research/market-data/">Read the methodology</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. TOOLS -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Tools & calculators" title="Do the maths before the meeting." lede="Free tools that turn your own numbers into budgets, targets and break-even points." />
      <div class="grid grid-3">
        {tools.slice(0, 6).map((t) => (
          <article class="card reveal">
            <div class="card-media"><Artwork seed={t.slug} motif={toolMotif[t.slug]} variant="light" /></div>
            <p class="tool-q">"{t.question}"</p>
            <h3><a class="card-link" href={`/tools/${t.slug}/`}>{t.title}</a></h3>
            <p>{t.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. WHY TBM -->
  <section class="section section--alt">
    <div class="container split">
      <SectionHead eyebrow="Why TBM" title="What makes the approach different." lede="Not louder claims. A clearer way of working." />
      <div class="grid grid-2 why">{why.map((w) => <div class="why-item"><h3>{w.t}</h3><p>{w.d}</p></div>)}</div>
    </div>
  </section>

  <!-- 13. PROCESS -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Process" title="They have a clear process." lede="What happens after you hire TBM: week by week." />
      <ol class="timeline" role="list">
        {onboarding.map((o) => <li class="reveal"><span class="when">{o.when}</span><strong>{o.what}</strong><p>{o.detail}</p></li>)}
      </ol>
      <p class="mt-2"><a href="/process/" class="text-link">Full onboarding detail <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
    </div>
  </section>

  <!-- 14. TEAM (shown once real profiles exist) -->
  {team.length > 0 && (
  <section class="section section--alt">
    <div class="container">
      <SectionHead eyebrow="Team" title="The people behind the work." lede="You will know who works on your account, by name." />
      <div class="grid grid-3">
        {team.map((m) => (
          <article class="card">
            {m.data.placeholder ? <Placeholder label="TEAM MEMBER PHOTO, NAME, ROLE: ADMIN TO ADD" /> : <><h3>{m.data.name}</h3><p>{m.data.role}</p></>}
          </article>
        ))}
      </div>
      <p class="mt-2"><a href="/team/" class="text-link">Meet the team <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></p>
    </div>
  </section>
  )}

  <!-- 15. TESTIMONIALS (verified + consented only) -->
  {(testimonials.length > 0 || preview) && (
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Client testimonials" title="In our clients' words." />
      {testimonials.length > 0 ? (
        <div class="grid grid-2">
          {testimonials.map((t) => (
            <figure class="card quote"><blockquote>"{t.data.quote}"</blockquote><figcaption><strong>{t.data.person}</strong>, {t.data.role}, {t.data.company}</figcaption></figure>
          ))}
        </div>
      ) : (
        <Placeholder label="CLIENT TESTIMONIALS: ADMIN TO ADD (verified, with written consent on file)" />
      )}
    </div>
  </section>
  )}

  <!-- 16. PRICING PHILOSOPHY -->
  <section class="section section--navy">
    <div class="container split">
      <SectionHead eyebrow="Pricing philosophy" title="Marketing should be an investment, not a black box." lede="I can see what I'm paying for." />
      <div>
        <div class="cost-split" role="img" aria-label="Costs are separated into agency fee, media spend, creative and production, and technology">
          {['Agency fee', 'Media spend', 'Creative & production', 'Technology'].map((c) => <span>{c}</span>)}
        </div>
        <p class="mt-1">Every proposal separates these lines. Media is paid directly to the platforms from accounts you own. Our rate card is public.</p>
        <div class="btn-row mt-1">
          <a class="btn btn--light" href="/pricing/">See the rate card</a>
          <a class="btn btn--outline-light" href="/guides/digital-marketing-cost-india/">Digital marketing cost guide</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 17. INSIGHTS -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Insights" title="Guides written to be useful, not to fill a calendar." />
      <div class="grid grid-3">
        {articles.map((a) => (
          <article class="card">
            <div class="card-media"><Artwork seed={a.id} motif={a.data.pillar ? 'book' : clusterMotif[a.data.cluster]} variant={a.data.pillar ? 'royal' : 'deep'} /></div>
            <span class="tag tag--neutral">{a.data.category}</span>
            <h3><a class="card-link" href={articleHref(a)}>{a.data.title}</a></h3>
            <p>{a.data.description}</p>
            <p class="meta">Updated {a.data.updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
          </article>
        ))}
      </div>
      <p class="mt-2"><a class="btn btn--ghost" href="/insights/">All insights</a></p>
    </div>
  </section>

  <!-- 18. FAQ -->
  <FAQ items={generalFaqs} />

  <!-- 19. FINAL CTA -->
  <CTABand stage="final" />
</Base>

<style>
  .hero { position: relative; padding-block: clamp(3rem, 7vw, 6.5rem) clamp(3rem, 6vw, 5.5rem); background: radial-gradient(80% 70% at 85% 10%, var(--royal-100), transparent 70%), linear-gradient(180deg, var(--royal-50), #fff 80%); overflow: hidden; }
  .hero-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1.25fr 1fr; } }
  .hero h1 { font-size: var(--step-5); margin-top: 1.25rem; max-width: 16ch; }
  .hero h1 span { color: var(--royal-600); }
  .hero .lede { margin-top: 1.5rem; max-width: 56ch; }
  .hero .btn-row { margin-top: 2rem; }
  .hero-note { margin-top: 1rem; }

  .trust { padding-block: 2rem; border-block: 1px solid var(--line); background: #fff; }
  .pillars { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 0; }
  .pillars li { font-family: var(--font-serif); font-size: var(--step-1); color: var(--navy-900); padding-inline: 1.1rem; }
  .pillars li + li { border-left: 1px solid var(--line-2); }
  @media (max-width: 600px) { .pillars { gap: 0.4rem 1rem; } .pillars li { padding-inline: 0; } .pillars li + li { border-left: 0; } }
  .trust-line { text-align: center; margin-top: 0.75rem; font-weight: 600; color: var(--royal-600); letter-spacing: 0.02em; }

  .intel-grid { display: grid; gap: 1.25rem; align-items: start; }
  @media (min-width: 1000px) { .intel-grid { grid-template-columns: 1.2fr 1fr; } }
  .intel-stats { display: grid; gap: 1rem; }
  .problems { --grid-gap: 1rem; }
  .problem { padding: 1.4rem; border-radius: var(--radius); border: 1px solid var(--line); background: #fff; }
  .problem h3 { font-size: 1.05rem; font-family: var(--font-sans); }
  .problem p { color: var(--ink-3); font-size: 0.93rem; margin-top: 0.35rem; }
  .connect { margin-top: 3rem; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 20px; background: var(--navy-900); color: #fff; }
  .connect-title { font-family: var(--font-serif); font-size: var(--step-2); }
  .chain { list-style: none; padding: 0; margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.5rem; counter-reset: c; }
  .chain li { counter-increment: c; display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; border-radius: 999px; background: rgb(255 255 255 / 0.08); font-weight: 600; }
  .chain li::before { content: counter(c); font-size: 0.75rem; color: #9fb8ff; }
  .chain li:not(:last-child)::after { content: ' to '; margin-left: 0.5rem; color: #6f95f5; }

  .svc-groups { display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }
  .svc-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--royal-600); margin-bottom: 0.5rem; }
  .svc-group ul, .list-links { list-style: none; padding: 0; }
  .svc-group a, .list-links a { display: grid; gap: 0.2rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; }
  .svc-group a strong, .list-links a strong { color: var(--navy-900); }
  .svc-group a span, .list-links a span { color: var(--ink-3); font-size: 0.9rem; }
  .svc-group a:hover strong, .list-links a:hover strong { color: var(--royal-600); }

  .ind-more { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .ind-more a { display: inline-block; padding: 0.45rem 0.9rem; border: 1px solid var(--line-2); border-radius: 999px; text-decoration: none; color: var(--ink); font-size: 0.9rem; background: #fff; }
  .ind-more a:hover { border-color: var(--royal-600); color: var(--royal-600); }

  .empty { display: grid; gap: 1.25rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper-2); }
  .empty-body { display: grid; gap: 1rem; color: var(--ink-2); }

  .tool-q { font-family: var(--font-serif); font-style: italic; color: var(--royal-700); }
  .why { --grid-gap: 2rem; }
  .why-item h3 { font-size: 1.1rem; font-family: var(--font-sans); }
  .why-item p { color: var(--ink-2); margin-top: 0.4rem; }

  .timeline { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .timeline li { position: relative; padding: 1.25rem 1.25rem 1.25rem; border-top: 3px solid var(--royal-600); background: var(--paper-2); border-radius: 0 0 var(--radius-sm) var(--radius-sm); }
  .timeline .when { display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--royal-600); }
  .timeline strong { display: block; font-size: 1.1rem; color: var(--navy-900); margin-top: 0.25rem; }
  .timeline p { font-size: 0.9rem; color: var(--ink-2); margin-top: 0.4rem; }

  .quote blockquote { font-family: var(--font-serif); font-size: var(--step-1); color: var(--navy-900); }
  .cost-split { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
  .cost-split span { padding: 1.1rem; border-radius: 12px; border: 1px solid rgb(255 255 255 / 0.18); background: rgb(255 255 255 / 0.05); font-weight: 620; color: #fff; }
</style>
