---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, has } from '../lib/site';
const industries = (await getCollection('industries')).map((i) => ({ id: i.id, title: i.data.title }));
---
<Base title="Your Growth Assessment Is Being Prepared" description="Thank you: here is what happens next." seo={{ noindex: true }}>
  <section class="section">
    <div class="container--narrow stack" style="--stack:1.5rem">
      <p class="eyebrow">Thank you</p>
      <h1 class="t">Your Growth Assessment is being prepared.</h1>
      <p class="lede">We've received your answers. A TBM strategist will review them, along with your website and channels, and call you back on the number you shared.</p>
      <div class="card">
        <h2 class="h">What happens next</h2>
        <p>Expect a call from us within one working day. Keep your phone handy, and have your monthly marketing spend and main goal in mind.</p>
        {has(site.whatsapp) && <p>Prefer WhatsApp? Message us on <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} data-track="cta_click" data-cta="whatsapp_thank_you">{site.whatsapp}</a>.</p>}
      </div>
      <div class="card card--muted" data-industry-box hidden>
        <h2 class="h">While you wait</h2>
        <p>Our playbook for your industry: <a data-industry-link href="#">industry guide</a>. You may also find the <a href="/research/">research hub</a> and <a href="/tools/marketing-roi-calculator/">ROI calculator</a> useful before we speak.</p>
      </div>
    </div>
  </section>
</Base>
<script define:vars={{ industries }}>
  const p = new URLSearchParams(location.search);
  const ind = industries.find((x) => x.id === p.get('i'));
  if (ind) {
    const box = document.querySelector('[data-industry-box]');
    const a = document.querySelector('[data-industry-link]');
    a.href = `/industries/${ind.id}/`; a.textContent = ind.title;
    box.hidden = false;
  }
</script>
<style>.t { font-size: var(--step-4); } .h { font-size: var(--step-2); }</style>
