---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { preview } from '../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('legal')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'legal'> };
const { Content } = await render(entry);
const crumbs = [{ name: 'Legal', href: '/legal/privacy-policy/' }, { name: entry.data.title, href: `/legal/${entry.id}/` }];
---
<Base title={entry.data.title} description={entry.data.description} crumbs={crumbs}>
  <PageHero crumbs={crumbs} eyebrow="Legal" title={entry.data.title} lede={`Last updated ${entry.data.updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}`} />
  <section class="section"><div class="container--narrow prose">
    {preview && !entry.data.reviewedByCounsel && <p class="placeholder">[DRAFT — TO BE REVIEWED BY QUALIFIED LEGAL COUNSEL BEFORE PUBLICATION]</p>}
    <Content />
  </div></section>
</Base>
