---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import CTABand from '../components/ui/CTABand.astro';
const crumbs = [{ name: 'Reporting demo', href: '/reporting-demo/' }];
const kpis = [
  ['spend', 'Spend'], ['impressions', 'Impressions'], ['clicks', 'Clicks'], ['ctr', 'CTR'], ['cpc', 'CPC'], ['leads', 'Leads'],
  ['cpl', 'CPL'], ['qualified', 'Qualified leads'], ['conversions', 'Conversions'], ['cac', 'CAC'], ['revenue', 'Revenue'], ['roas', 'ROAS'],
];
---
<Base title="Reporting Demo: How TBM Reports" description="An interactive demo of a TBM performance dashboard: spend, impressions, clicks, CTR, CPC, leads, CPL, qualified leads, CAC, conversions, revenue and ROAS. Demo data only." crumbs={crumbs}>
  <PageHero crumbs={crumbs} art={{ seed: 'reporting', motif: 'chart', variant: 'deep' }} eyebrow="Reporting demo" title="See how we report before you hire us." lede="This is the shape of the monthly view every TBM client gets: business outcomes first, platform metrics as the explanation." />
  <section class="section" data-hide-sticky>
    <div class="container" data-demo>
      <div class="demo-banner" role="note"><strong>DEMO DATA: NOT CLIENT DATA.</strong> Every number on this page is synthetic sample data generated for illustration. It does not represent any client, benchmark or expected result.</div>

      <div class="controls" role="group" aria-label="Dashboard filters">
        <div class="filters" role="group" aria-label="Period">
          <button class="chip" aria-pressed="false" data-period="3">3 months</button>
          <button class="chip" aria-pressed="true" data-period="6">6 months</button>
          <button class="chip" aria-pressed="false" data-period="12">12 months</button>
        </div>
        <div class="filters" role="group" aria-label="Channel">
          <button class="chip" aria-pressed="true" data-channel="all">All channels</button>
          <button class="chip" aria-pressed="false" data-channel="google">Google Ads</button>
          <button class="chip" aria-pressed="false" data-channel="meta">Meta Ads</button>
        </div>
      </div>

      <div class="kpis">
        {kpis.map(([k, l]) => <div class="kpi-tile"><span class="kpi-label">{l}</span><span class="kpi-value num" data-k={k}>-</span><span class="kpi-delta" data-d={k}></span></div>)}
      </div>

      <div class="charts">
        <figure class="panel">
          <figcaption>Qualified leads by month <span class="muted">(demo)</span></figcaption>
          <svg viewBox="0 0 600 240" role="img" aria-label="Qualified leads by month, demo data" data-chart="leads"></svg>
        </figure>
        <figure class="panel">
          <figcaption>Cost per qualified lead by month <span class="muted">(demo, ₹)</span></figcaption>
          <svg viewBox="0 0 600 240" role="img" aria-label="Cost per qualified lead by month, demo data" data-chart="cpql"></svg>
        </figure>
      </div>

      <div class="panel mt-2">
        <p class="ptitle">Channel breakdown <span class="muted">(demo)</span></p>
        <div class="table-wrap"><table class="data-table"><thead><tr><th scope="col">Channel</th><th scope="col">Spend</th><th scope="col">Leads</th><th scope="col">Qualified</th><th scope="col">CPL</th><th scope="col">Customers</th><th scope="col">Revenue</th><th scope="col">ROAS</th></tr></thead><tbody data-table></tbody></table></div>
      </div>

      <div class="panel mt-2 notes">
        <p class="ptitle">What a TBM monthly review adds</p>
        <ul class="check-list">
          <li>What changed and why, in plain language, not just charts</li>
          <li>Numbers reconciled with your CRM, not only platform-reported conversions</li>
          <li>Tests run, results and decisions (scale, fix or stop)</li>
          <li>Next month's plan and budget recommendation</li>
        </ul>
      </div>
      <div class="tip" role="tooltip" hidden data-tip></div>
    </div>
  </section>
  <CTABand stage="bofu" />
</Base>

<script>
  import { inr, num } from '../lib/calculators';
  const root = document.querySelector<HTMLElement>('[data-demo]')!;
  const tip = root.querySelector<HTMLElement>('[data-tip]')!;
  // Deterministic synthetic data (seeded): DEMO ONLY.
  let seed = 42;
  const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
  const months = Array.from({ length: 12 }, (_, i) => new Date(2026, i - 11 + 8, 1).toLocaleDateString('en-IN', { month: 'short' }));
  type Row = { spend: number; impressions: number; clicks: number; leads: number; qualified: number; customers: number; revenue: number };
  const gen = (base: number, cpm: number, ctr: number, cvr: number, q: number): Row[] => months.map((_, i) => {
    const spend = base * (1 + i * 0.04) * (0.9 + rnd() * 0.2);
    const impressions = (spend / cpm) * 1000;
    const clicks = impressions * ctr * (0.9 + rnd() * 0.2);
    const leads = clicks * cvr * (1 + i * 0.015);
    const qualified = leads * q * (0.92 + rnd() * 0.16);
    const customers = qualified * 0.12;
    return { spend, impressions, clicks, leads, qualified, customers, revenue: customers * 85000 };
  });
  const data: Record<string, Row[]> = { google: gen(180000, 380, 0.045, 0.06, 0.45), meta: gen(140000, 140, 0.011, 0.07, 0.3) };
  let period = 6, channel = 'all';

  const series = (): Row[] => {
    const keys = channel === 'all' ? ['google', 'meta'] : [channel];
    return months.map((_, i) => keys.reduce((a, k) => {
      const r = data[k][i];
      (Object.keys(a) as (keyof Row)[]).forEach((f) => (a[f] += r[f]));
      return a;
    }, { spend: 0, impressions: 0, clicks: 0, leads: 0, qualified: 0, customers: 0, revenue: 0 }));
  };
  const sum = (rows: Row[]) => rows.reduce((a, r) => { (Object.keys(a) as (keyof Row)[]).forEach((f) => (a[f] += r[f])); return a; }, { spend: 0, impressions: 0, clicks: 0, leads: 0, qualified: 0, customers: 0, revenue: 0 });
  const derive = (t: Row) => ({
    spend: inr(t.spend), impressions: num(t.impressions), clicks: num(t.clicks), ctr: `${num((t.clicks / t.impressions) * 100, 2)}%`,
    cpc: inr(t.spend / t.clicks, false), leads: num(t.leads), cpl: inr(t.spend / t.leads, false), qualified: num(t.qualified),
    conversions: num(t.customers), cac: inr(t.spend / t.customers), revenue: inr(t.revenue), roas: `${num(t.revenue / t.spend, 2)}x`,
    _cpl: t.spend / t.leads, _cac: t.spend / t.customers, _roas: t.revenue / t.spend, _q: t.qualified,
  });

  const drawBars = (svg: SVGSVGElement, labels: string[], vals: number[], fmt: (n: number) => string) => {
    const W = 600, H = 240, p = { t: 20, b: 30, l: 8, r: 8 };
    const max = Math.max(...vals) * 1.15, bw = (W - p.l - p.r) / vals.length, w = Math.min(40, bw * 0.6);
    const y = (v: number) => p.t + (H - p.t - p.b) * (1 - v / max);
    svg.innerHTML = [0.5, 1].map((f) => `<line x1="${p.l}" x2="${W - p.r}" y1="${y(max * f / 1.15)}" y2="${y(max * f / 1.15)}" stroke="#e8e9ec"/>`).join('') +
      vals.map((v, i) => { const cx = p.l + bw * i + bw / 2, h = y(0) - y(v);
        return `<g class="m" tabindex="0" data-label="${labels[i]}: ${fmt(v)}"><rect x="${cx - bw / 2}" y="${p.t}" width="${bw}" height="${H - p.t - p.b}" fill="transparent"/><path d="M${cx - w / 2},${y(0)} v${-(h - 4)} q0,-4 4,-4 h${w - 8} q4,0 4,4 v${h - 4} z" fill="#2a78d6"/><text x="${cx}" y="${H - 10}" text-anchor="middle" font-size="12" fill="#5d6477">${labels[i]}</text></g>`; }).join('') +
      `<line x1="${p.l}" x2="${W - p.r}" y1="${y(0)}" y2="${y(0)}" stroke="#9aa1b1"/>`;
  };
  const drawLine = (svg: SVGSVGElement, labels: string[], vals: number[], fmt: (n: number) => string) => {
    const W = 600, H = 240, p = { t: 20, b: 30, l: 20, r: 20 };
    const max = Math.max(...vals) * 1.15, min = 0, step = (W - p.l - p.r) / Math.max(1, vals.length - 1);
    const y = (v: number) => p.t + (H - p.t - p.b) * (1 - (v - min) / (max - min));
    const pts = vals.map((v, i) => [p.l + step * i, y(v)]);
    svg.innerHTML = [0.5, 1].map((f) => `<line x1="${p.l}" x2="${W - p.r}" y1="${y(max * f / 1.15)}" y2="${y(max * f / 1.15)}" stroke="#e8e9ec"/>`).join('') +
      `<polyline points="${pts.map((q) => q.join(',')).join(' ')}" fill="none" stroke="#2a78d6" stroke-width="2" stroke-linejoin="round"/>` +
      pts.map(([x, yy], i) => `<g class="m" tabindex="0" data-label="${labels[i]}: ${fmt(vals[i])}"><rect x="${x - step / 2}" y="${p.t}" width="${step}" height="${H - p.t - p.b}" fill="transparent"/><circle cx="${x}" cy="${yy}" r="5" fill="#2a78d6" stroke="#fff" stroke-width="2"/><text x="${x}" y="${H - 10}" text-anchor="middle" font-size="12" fill="#5d6477">${labels[i]}</text></g>`).join('');
  };

  const render = () => {
    const all = series();
    const cur = all.slice(12 - period), prev = all.slice(Math.max(0, 12 - period * 2), 12 - period);
    const now = derive(sum(cur));
    const before = prev.length === period ? derive(sum(prev)) : null;
    Object.entries(now).forEach(([k, v]) => { const el = root.querySelector(`[data-k="${k}"]`); if (el) el.textContent = String(v); });
    const delta = (k: string, a?: number, b?: number, lowerBetter = false) => {
      const el = root.querySelector<HTMLElement>(`[data-d="${k}"]`); if (!el) return;
      if (!a || !b) { el.textContent = ''; return; }
      const ch = ((a - b) / b) * 100, good = lowerBetter ? ch < 0 : ch > 0;
      el.textContent = `${ch > 0 ? '+' : '-'} ${num(Math.abs(ch), 1)}% vs prior ${period}m`;
      el.className = `kpi-delta ${good ? 'up' : 'down'}`;
    };
    delta('cpl', now._cpl, before?._cpl, true); delta('cac', now._cac, before?._cac, true); delta('roas', now._roas, before?._roas); delta('qualified', now._q, before?._q);
    const labels = months.slice(12 - period);
    drawBars(root.querySelector('[data-chart="leads"]')!, labels, cur.map((r) => r.qualified), (n) => num(n));
    drawLine(root.querySelector('[data-chart="cpql"]')!, labels, cur.map((r) => r.spend / r.qualified), (n) => inr(n, false));
    const rows = (channel === 'all' ? ['google', 'meta'] : [channel]).map((k) => {
      const t = sum(data[k].slice(12 - period));
      return `<tr><th scope="row">${k === 'google' ? 'Google Ads' : 'Meta Ads'}</th><td class="num">${inr(t.spend)}</td><td class="num">${num(t.leads)}</td><td class="num">${num(t.qualified)}</td><td class="num">${inr(t.spend / t.leads, false)}</td><td class="num">${num(t.customers)}</td><td class="num">${inr(t.revenue)}</td><td class="num">${num(t.revenue / t.spend, 2)}x</td></tr>`;
    });
    root.querySelector('[data-table]')!.innerHTML = rows.join('');
  };

  root.querySelectorAll<HTMLButtonElement>('[data-period]').forEach((b) => b.addEventListener('click', () => {
    period = Number(b.dataset.period); root.querySelectorAll('[data-period]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); render();
  }));
  root.querySelectorAll<HTMLButtonElement>('[data-channel]').forEach((b) => b.addEventListener('click', () => {
    channel = b.dataset.channel!; root.querySelectorAll('[data-channel]').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); render();
  }));
  const showTip = (e: Event) => {
    const g = (e.target as Element).closest<SVGGElement>('.m'); if (!g) return;
    const r = g.getBoundingClientRect(), host = root.getBoundingClientRect();
    tip.textContent = `${g.dataset.label} (demo)`; tip.hidden = false;
    tip.style.left = `${r.left - host.left + r.width / 2}px`; tip.style.top = `${r.top - host.top + 10}px`;
  };
  root.addEventListener('mouseover', showTip); root.addEventListener('focusin', showTip);
  root.addEventListener('mouseleave', () => (tip.hidden = true)); root.addEventListener('focusout', () => (tip.hidden = true));
  render();
</script>

<style>
  [data-demo] { position: relative; }
  .demo-banner { padding: 1rem 1.25rem; border: 2px dashed #c9a24a; background: #fff6e5; color: #6d4b00; border-radius: var(--radius-sm); font-size: 0.95rem; }
  .controls { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-block: 1.5rem; }
  .kpis { display: grid; gap: 1px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr)); background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .kpi-tile { background: #fff; padding: 1rem 1.1rem; display: grid; gap: 0.2rem; }
  .kpi-label { font-size: 0.78rem; color: var(--ink-3); font-weight: 600; }
  .kpi-value { font-family: var(--font-serif); font-size: var(--step-2); color: var(--navy-900); }
  .kpi-delta { font-size: 0.78rem; font-weight: 600; min-height: 1em; }
  .kpi-delta.up { color: var(--good); }
  .kpi-delta.down { color: var(--bad); }
  .charts { display: grid; gap: 1rem; margin-top: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .panel { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; background: #fff; }
  .panel figcaption, .ptitle { font-weight: 650; color: var(--navy-900); margin-bottom: 0.75rem; }
  .panel svg { width: 100%; height: auto; overflow: visible; }
  .panel :global(.m) { outline: none; }
  .panel :global(svg:has(.m:hover) .m:not(:hover) path) { opacity: 0.5; }
  .tip { position: absolute; transform: translate(-50%, -110%); background: var(--navy-900); color: #fff; padding: 0.4rem 0.6rem; border-radius: 6px; font-size: 0.82rem; pointer-events: none; white-space: nowrap; z-index: 5; }
</style>
